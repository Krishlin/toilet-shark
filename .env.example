# Booking form config for /api/book.js
# These are NOT committed. Set them in Vercel → Project → Settings →
# Environment Variables (and, for local testing, copy this file to
# `.env.local` and run `vercel dev`).

# Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=

# Where bookings are emailed. One address, or several comma-separated.
BOOKING_TO=owner@example.com

# Verified Resend sender. The domain must be verified in Resend.
BOOKING_FROM=Toilet Shark <bookings@your-sending-domain.com>
n# Pick something hard to guess - anyone who knows the topic name can postnNTFY_TOPIC=

# ntfy.sh topic for phone push alerts on new bookings (optional).
# Pick something hard to guess - anyone who knows the topic name can post
# to it or read it. https://ntfy.sh/<topic> ; subscribe in the ntfy app.
NTFY_TOPIC=
